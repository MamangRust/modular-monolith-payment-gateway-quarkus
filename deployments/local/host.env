# Host-Java local mode. PostgreSQL, Redis, Kafka, and observability remain containerized.
APP_ENV=local

DB_HOST=localhost
DB_PORT=5432
DB_USER=DRAGON
DB_PASS=DRAGON
DB_USERNAME=DRAGON
DB_PASSWORD=DRAGON
DB_NAME=PAYMENT_GATEWAY

KAFKA_ADVERTISED_HOST=localhost
KAFKA_BROKERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

REDIS_PASSWORD=dragon_knight
REDIS_CLUSTER_ENABLED=true
REDIS_HOSTS=redis://:dragon_knight@localhost:6379,redis://:dragon_knight@localhost:6380,redis://:dragon_knight@localhost:6381,redis://:dragon_knight@localhost:6382,redis://:dragon_knight@localhost:6383,redis://:dragon_knight@localhost:6384

OTEL_ENDPOINT=localhost:4317
QUARKUS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
CHAOS_CONFIG_PATH=./chaos.yaml
